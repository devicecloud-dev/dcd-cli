{
  "author": "devicecloud.dev",
  "bin": {
    "dcd": "dist/index.js",
    "dcd-mcp": "dist/mcp/index.js"
  },
  "dependencies": {
    "@clack/prompts": "^1.6.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@supabase/supabase-js": "^2.108.2",
    "bplist-parser": "^0.5.0",
    "chalk": "^6.0.0",
    "citty": "^0.2.2",
    "js-yaml": "^5.2.2",
    "node-stream-zip": "^1.15.0",
    "plist": "^5.0.0",
    "tar": "^7.5.16",
    "tus-js-client": "^4.3.1",
    "yazl": "^3.3.1",
    "zod": "^4.4.3"
  },
  "description": "Run Maestro mobile UI tests in the cloud — upload an iOS/Android build, execute flows across real devices, and stream results. Ships the dcd CLI and a dcd-mcp MCP server.",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.0.0",
    "@types/yazl": "^3.3.1",
    "chai": "^6.2.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-unicorn": "^79.0.0",
    "husky": "^9.1.7",
    "mocha": "^12.0.0",
    "prettier": "^3.8.4",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "/dist"
  ],
  "homepage": "https://devicecloud.dev",
  "license": "MIT",
  "main": "dist/index.js",
  "name": "@devicecloud.dev/dcd",
  "private": false,
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devicecloud-dev/dcd-cli.git"
  },
  "scripts": {
    "dcd": "tsx src/index.ts",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -b && node -e \"for (const f of ['dist/index.js','dist/mcp/index.js']) require('node:fs').chmodSync(f,0o755)\"",
    "build:binaries": "node scripts/build-binaries.mjs",
    "lint": "eslint src test --ext .ts",
    "prepare": "pnpm build && husky",
    "test": "node scripts/test-runner.mjs",
    "test:unit": "node scripts/test-runner.mjs --unit",
    "typecheck": "tsc --noEmit -p tsconfig.test.json"
  },
  "version": "5.15.0",
  "bugs": {
    "url": "https://discord.gg/gm3mJwcNw8"
  },
  "keywords": [
    "devicecloud",
    "devicecloud.dev",
    "dcd",
    "cloud",
    "maestro",
    "testing"
  ],
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./e2e": {
      "types": "./dist/e2e/index.d.ts",
      "default": "./dist/e2e/index.js"
    },
    "./package.json": "./package.json",
    "./dist/*": "./dist/*"
  },
  "packageManager": "pnpm@10.17.1",
  "pnpm": {
    "overrides": {
      "minimatch@>=10.0.0 <11.0.1": "11.0.1",
      "glob@>=9.0.0 <14.0.2": "14.0.2"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-frvp-7c67-39w9",
        "GHSA-vfj7-8cjw-p6xm",
        "GHSA-fc5q-39xc-vjpf"
      ]
    }
  }
}
